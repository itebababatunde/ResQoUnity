Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Color: 100; 100; 100
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 5
        Y: 5
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: odom

    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Value: true
      Topic:
        Value: /viz/planned_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.08
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None

    - Class: rviz_default_plugins/Marker
      Name: Workspace Boundary
      Enabled: true
      Value: true
      Topic:
        Value: /viz/workspace_boundary
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: Sweep Lines
      Enabled: true
      Value: true
      Topic:
        Value: /viz/sweep_lines
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Path
      Name: Drone Trail
      Enabled: true
      Value: true
      Topic:
        Value: /viz/drone_trail
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.05
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None

    - Class: rviz_default_plugins/Path
      Name: Dog0 Trail
      Enabled: true
      Value: true
      Topic:
        Value: /viz/dog0_trail
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None

    - Class: rviz_default_plugins/Path
      Name: Dog1 Trail
      Enabled: true
      Value: true
      Topic:
        Value: /viz/dog1_trail
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.05
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None

    - Class: rviz_default_plugins/Marker
      Name: Current Target
      Enabled: true
      Value: true
      Topic:
        Value: /viz/current_target
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Marker
      Name: Progress
      Enabled: true
      Value: true
      Topic:
        Value: /viz/progress
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 5
        Y: 5
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5707963
      Target Frame: odom
      Value: Orbit (rviz_default_plugins)
      Yaw: 4.7123890
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
  X: 100
  Y: 100
